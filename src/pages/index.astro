---
import Layout from "@/layouts/Layout.astro";
import EmojiExporterView from "@/components/EmojiExporterView.vue";
import { ROUTES } from "@/utils/constant";
---

<Layout
  title={ROUTES.home.title}
  description={ROUTES.home.description}
  currentPath="/"
  showAmbientGlows={true}
  mainClass="relative z-10 flex-1 py-4 sm:py-10 px-3 sm:px-6 flex flex-col justify-center"
>
  <EmojiExporterView client:only="vue" />
</Layout>
