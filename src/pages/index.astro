---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import EmojiExporterView from '../components/EmojiExporterView.vue';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PixEmoji — Exportador de Emojis a PNG Transparente</title>
  <meta name="description" content="Exporta cualquier emoji a imagen PNG en alta resolución (256px a 2048px) con fondo transparente y posicionamiento interactivo sobre lienzo Konva.js." />
  <meta name="author" content="PixEmoji" />

  <!-- Open Graph / Social Media -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="PixEmoji — Exportador de Emojis a PNG Transparente" />
  <meta property="og:description" content="Posiciona, rota y exporta cualquier emoji en alta resolución con fondo transparente sobre lienzo interactivo." />

  <!-- Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>✨</text></svg>" />

  <!-- Preconnect Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body class="min-h-screen bg-app-gradient text-text-main flex flex-col selection:bg-primary-200 selection:text-primary-900">
  <!-- Decorative ambient glows -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-primary-200/40 rounded-full blur-3xl"></div>
    <div class="absolute top-1/3 -right-40 w-96 h-96 bg-primary-300/30 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 left-1/3 w-96 h-96 bg-rose-200/30 rounded-full blur-3xl"></div>
  </div>

  <!-- Reusable Navigation Bar -->
  <Navbar currentPath="/" />

  <!-- Main Content -->
  <main class="relative z-10 flex-1 py-8 sm:py-10 px-4 sm:px-6 flex flex-col justify-center">
    <EmojiExporterView client:only="vue" />
  </main>

  <!-- Footer -->
  <footer class="relative z-10 w-full border-t border-app-border py-6 px-4 text-center text-xs text-text-subtle glass-card">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
      <p>&copy; {new Date().getFullYear()} <strong>PixEmoji</strong> &mdash; Exportador interactivo con Konva.js y selector Unicode.</p>
      <p class="text-[11px] text-text-hint">Generado localmente en tu navegador mediante HTML5 Canvas.</p>
    </div>
  </footer>
</body>
</html>
