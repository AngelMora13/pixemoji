---
import Layout from "@/layouts/Layout.astro";
import { ROUTES } from "@/utils/constant";
---

<Layout
  title={ROUTES.notFound.title}
  description={ROUTES.notFound.description}
  noIndex={true}
  currentPath="/404"
  showAmbientGlows={true}
  mainClass="relative z-10 flex-1 py-12 px-4 sm:px-6 flex flex-col items-center justify-center text-center"
>
  <div class="max-w-md w-full glass-card p-8 sm:p-10 rounded-3xl border border-app-border shadow-card flex flex-col items-center">
    <!-- Animated Emoji Avatar -->
    <div class="relative mb-6">
      <div class="w-24 h-24 rounded-3xl bg-primary-100 border border-primary-200 flex items-center justify-center text-5xl shadow-brand/20 shadow-lg animate-bounce">
        🛸
      </div>
      <div class="absolute -bottom-2 -right-2 text-2xl">
        ❓
      </div>
    </div>

    <!-- Status Code & Title -->
    <span class="text-xs font-black tracking-widest uppercase px-3 py-1 rounded-full bg-primary-100 text-primary-800 border border-primary-300 mb-3">
      Error 404
    </span>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-text-main tracking-tight mb-2">
      ¡Página no encontrada!
    </h1>
    <p class="text-sm text-text-muted mb-8 leading-relaxed">
      El emoji o lienzo que buscas no existe, cambió de dirección o se ha desvanecido en el espacio digital.
    </p>

    <!-- Quick Navigation Actions -->
    <div class="w-full flex flex-col sm:flex-row items-center gap-3">
      <a
        href="/"
        class="w-full sm:flex-1 py-3 px-4 rounded-2xl bg-primary-gradient text-white text-xs font-bold shadow-md shadow-primary-600/30 hover:opacity-95 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2"
      >
        <span>🧁</span>
        <span>Exportador Emoji</span>
      </a>

      <a
        href="/meme"
        class="w-full sm:flex-1 py-3 px-4 rounded-2xl bg-white/90 text-text-main text-xs font-bold border border-app-border hover:bg-white hover:border-primary-300 hover:text-primary-600 shadow-sm active:scale-[0.98] transition-all flex items-center justify-center gap-2"
      >
        <span>🎨</span>
        <span>Meme Studio</span>
      </a>
    </div>
  </div>
</Layout>
