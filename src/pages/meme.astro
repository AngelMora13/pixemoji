---
import Layout from "@/layouts/Layout.astro";
import MemeStudioView from "@/components/MemeStudioView.vue";
import { ROUTES } from "@/utils/constant";
---

<Layout
  title={ROUTES.meme.title}
  description={ROUTES.meme.description}
  currentPath="/meme"
  hideNavbar={true}
  hideFooter={true}
  bodyClass="h-screen h-[100dvh] font-sans text-text-main flex flex-col antialiased select-none overflow-hidden bg-app-bg selection:bg-primary-100 selection:text-primary-800"
  mainClass="relative z-10 flex-1 flex flex-col overflow-hidden min-h-0 h-full"
>
  <MemeStudioView client:only="vue" />
</Layout>
