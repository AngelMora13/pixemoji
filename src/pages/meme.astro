---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import MemeStudioView from '../components/MemeStudioView.vue';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Meme & Sticker Studio — PixEmoji</title>
  <meta name="description" content="Crea memes, stickers e imágenes personalizadas combinando emojis, textos con bordes tipográficos, imágenes y fondos transparentes o de color con Konva.js." />
  <meta name="author" content="PixEmoji" />

  <!-- Open Graph / Social Media -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Meme & Sticker Studio — PixEmoji" />
  <meta property="og:description" content="Editor gráfico multi-capa: añade emojis, textos con estilo meme, imágenes y gestiona capas fácilmente con Konva." />

  <!-- Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎨</text></svg>" />

  <!-- Preconnect Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body class="min-h-screen bg-gradient-to-b from-[#fffbf7] via-[#f8ede3] to-[#eedac9] text-[#2b1e1a] flex flex-col selection:bg-amber-200 selection:text-amber-900">
  <!-- Decorative ambient glows -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-orange-200/40 rounded-full blur-3xl"></div>
    <div class="absolute top-1/3 -right-40 w-96 h-96 bg-amber-200/30 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 left-1/3 w-96 h-96 bg-rose-200/30 rounded-full blur-3xl"></div>
  </div>

  <!-- Reusable Navigation Bar -->
  <Navbar currentPath="/meme" />

  <!-- Main Studio Content -->
  <main class="relative z-10 flex-1 py-6 sm:py-8 px-4 sm:px-6 flex flex-col justify-center">
    <MemeStudioView client:only="vue" />
  </main>

  <!-- Footer -->
  <footer class="relative z-10 w-full border-t border-[#ebd8ca]/80 py-6 px-4 text-center text-xs text-[#8a6e60] glass-card">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
      <p>&copy; {new Date().getFullYear()} <strong>PixEmoji Studio</strong> &mdash; Editor multi-capa con Konva.js y exportador de imágenes.</p>
      <p class="text-[11px] text-[#a08272]">Privacidad total: el renderizado y las imágenes se procesan 100% en memoria en tu navegador.</p>
    </div>
  </footer>
</body>
</html>
