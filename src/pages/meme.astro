---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import MemeStudioView from '../components/MemeStudioView.vue';
---

<!DOCTYPE html>
<html lang="es" class="h-full bg-app-bg">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Meme & Sticker Studio — PixEmoji</title>
  <meta name="description" content="Crea memes, stickers e imágenes personalizadas combinando emojis, textos con bordes tipográficos, imágenes y fondos transparentes o de color con Konva.js." />
  <meta name="author" content="PixEmoji" />

  <!-- Open Graph / Social Media -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Meme & Sticker Studio — PixEmoji" />
  <meta property="og:description" content="Editor gráfico multi-capa: añade emojis, textos con estilo meme, imágenes y gestiona capas fácilmente con Konva." />

  <!-- Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎨</text></svg>" />

  <!-- Preconnect Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body class="h-screen font-sans text-text-main flex flex-col antialiased select-none overflow-hidden bg-app-bg selection:bg-primary-100 selection:text-primary-800">
  <!-- Reusable Navigation Bar -->
  <Navbar currentPath="/meme" />

  <!-- Main Studio Workspace Container (Takes full viewport height below header) -->
  <main class="relative z-10 flex-1 flex flex-col overflow-hidden min-h-0">
    <MemeStudioView client:only="vue" />
  </main>
</body>
</html>
